{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register src/index.ts",
    "build": "tsc -p tsconfig.build.json && npm run postbuild:alias",
    "postbuild:alias": "node -e \"const fs=require('fs');fs.rmSync('node_modules/@shared',{recursive:true,force:true});fs.cpSync('dist/shared','node_modules/@shared',{recursive:true});console.log('[build] @shared exposto em node_modules/@shared')\"",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
